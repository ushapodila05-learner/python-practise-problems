
#LCM OF TWO NUMBERS
a=int(input("ENTER THE VALUE OF a: "))
b=int(input("ENTER THE VALUE OF b: "))
set1=set()
set2=set()
for i in range (1,11):
   set1.add(i*a)
for i in range (1,11):
    set2.add(i*b)
print(set1)
print(set2)
common=set1.intersection(set2)
print(common)
print(min(common))  
